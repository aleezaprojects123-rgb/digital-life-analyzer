# --- .NET ---
bin/
obj/
.vs/
*.user

# --- Node ---
node_modules/

# --- Secrets: passwords, API keys, encryption keys, certificates ---
.env
.env.*
!.env.example
*.key
*.pem
# The extension's development signing key is kept OUTSIDE the repo (in your user folder, .dla-keys). Never commit it.
*.crx
.dla-keys/

# --- Local agent files: these live in %LocalAppData%\DigitalLifeAnalyzer, never in the repo ---
consent.json
agent-link.json
*.pfx
secrets.json
appsettings.Development.json

# --- Local data: activity data is personal, never commit it ---
*.db
*.sqlite
*.sqlite3
*.log
exports/

# --- OS and editor files ---
.DS_Store
Thumbs.db
.vscode/
