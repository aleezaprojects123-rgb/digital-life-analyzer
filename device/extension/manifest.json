{
  "manifest_version": 3,
  "name": "Digital Life Analyzer",
  "version": "0.0.2",
  "description": "Companion for the Digital Life Analyzer desktop agent. Records the active website only after you have agreed in the desktop app.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:49721/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Digital Life Analyzer",
    "default_popup": "popup.html"
  }
}
