# Template for environment variables. Placeholder NAMES only, no real values.
# For cloud/ (Fatima). To use it: copy this file to ".env" and fill in your own values.
#
# NEVER commit ".env". It is listed in .gitignore. Never put a real value in THIS file:
# this repository is public.

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- App security ---
# Secret used to sign login tokens
JWT_SECRET=
# Key used to encrypt summaries (where this key lives is still to be decided)
ENCRYPTION_KEY=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Calendar sync (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- App address ---
APP_BASE_URL=
