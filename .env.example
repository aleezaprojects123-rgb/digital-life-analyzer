# Template for environment variables. Placeholder NAMES only, no real values.
# For cloud/ (Fatima). To use it: copy this file to ".env" and fill in your own values.
#
# NEVER commit ".env". It is listed in .gitignore. Never put a real value in THIS file:
# this repository is public.

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- App security ---
# Secret used to sign login tokens
JWT_SECRET=
# Key used to encrypt summaries. It is a server secret held in the server's environment
# (decision of 27 Oct 2026). Never commit a real value.
ENCRYPTION_KEY=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- App address ---
APP_BASE_URL=
